# Server-only. Copy to .dev.vars for local Cloudflare/Vinext development.
# Never prefix a secret with NEXT_PUBLIC_ or VITE_. Never commit .dev.vars.
ELEVENLABS_API_KEY=
# Only enable if your ElevenLabs enterprise plan supports zero-retention requests.
ELEVENLABS_ZERO_RETENTION=false
# The live Realtime route uses ELEVENLABS_API_KEY to issue a temporary browser token.
# ELEVENLABS_ZERO_RETENTION above applies only to the older batch transcription route.
# The live prototype always discloses standard ElevenLabs retention; no Meta key is needed.

# Presage SmartSpectra (camera physiology). Read by the local bridge
# (`pnpm presage:bridge`) from .dev.vars or the environment; never sent to the browser.
SMARTSPECTRA_API_KEY=
# Optional. Where the browser finds the bridge (not a secret).
PRESAGE_BRIDGE_URL=ws://127.0.0.1:8790/presage
# Optional. Bridge port and the page origins allowed to use it.
PRESAGE_BRIDGE_PORT=8790
PRESAGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. 1 = labelled mock values for UI development (same as `pnpm presage:mock`).
SMARTSPECTRA_MOCK=0
