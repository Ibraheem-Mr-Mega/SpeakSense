# Server-only. Copy to .dev.vars for local Cloudflare/Vinext development.
# Never prefix a secret with NEXT_PUBLIC_ or VITE_. Never commit .dev.vars.
ELEVENLABS_API_KEY=
# Only enable if your ElevenLabs enterprise plan supports zero-retention requests.
ELEVENLABS_ZERO_RETENTION=false
# The live Realtime route uses ELEVENLABS_API_KEY to issue a temporary browser token.
# ELEVENLABS_ZERO_RETENTION above applies only to the older batch transcription route.
# The live prototype always discloses standard ElevenLabs retention; no Meta key is needed.

# Local native camera service only; never delivered to the browser or Cloudflare.
PRESAGE_API_KEY=

# Hosted camera service only (set as runtime secrets in DigitalOcean)
CAMERA_HOSTED=false
CAMERA_ACCESS_KEY=
CAMERA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CAMERA_MAX_SESSIONS_PER_HOUR=20
